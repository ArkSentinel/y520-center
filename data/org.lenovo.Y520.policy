<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Lenovo Y520 Nerve Center</vendor>
  <!-- Acción única para todo: con auth_admin_keep la contraseña se pide
       una sola vez y vale para enfriamiento, batería y teclado. -->
  <action id="org.lenovo.Y520.manage">
    <description>Gestionar Extreme Cooling, batería y teclado del Y520</description>
    <message>Se requiere autenticación para gestionar el Legion Y520.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
