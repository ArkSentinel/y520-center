# Y520 Center — regla udev para retroiluminación USB ITE (fallback).
# SPDX-License-Identifier: GPL-3.0-or-later
#
# NOTA Y520-15IKBN (80WK) verificado en esta máquina: el teclado es blanco
# de 2 niveles vía ideapad_acpi en /sys/class/leds/platform::kbd_backlight
# (brightness 0/1/2) y NO expone ningún USB ITE 048d:c963/c965
# (comprobado con `lsusb | grep 048d`, ausente). Por tanto esta regla NO es
# necesaria en el Y520 verificado y solo actúa como fallback permisivo por si
# alguna variante Y520 expone el controlador USB ITE del repo
# InstinctEx/lenovo-ideapad-legion-keyboard-led.

SUBSYSTEM=="usb", ATTR{idVendor}=="048d", ATTR{idProduct}=="c963", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="048d", ATTR{idProduct}=="c965", MODE="0666", TAG+="uaccess"
